LLM_PROVIDER=llama_cpp
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=local-development
LLM_MODEL=llama-local
LLM_TIMEOUT_SECONDS=60
WHISPER_ENABLED=false
WHISPER_CLI_PATH=whisper-cli
WHISPER_MODEL_PATH=/absolute/path/to/ggml-base.en.bin
WHISPER_LANGUAGE=en
WHISPER_TIMEOUT_SECONDS=1800
FFMPEG_PATH=ffmpeg
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-this-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CACHE_URL=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=true
DEFAULT_FROM_EMAIL=TALA-AI <noreply@tala.local>
FRONTEND_URL=http://localhost:5173
