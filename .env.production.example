POSTGRES_PASSWORD=replace-with-a-long-random-password
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=tala.example.org
CSRF_TRUSTED_ORIGINS=https://tala.example.org
WEB_PORT=8080
LLM_PROVIDER=llama_cpp
LLM_BASE_URL=http://host.docker.internal:8080/v1
LLM_API_KEY=local-development
LLM_MODEL=llama-local
LLM_TIMEOUT_SECONDS=60
WHISPER_ENABLED=false
WHISPER_CLI_PATH=/opt/whisper/bin/whisper-cli
WHISPER_MODEL_PATH=/opt/whisper/models/ggml-base.en.bin
WHISPER_LANGUAGE=en
WHISPER_TIMEOUT_SECONDS=1800
FFMPEG_PATH=/usr/bin/ffmpeg
DEFAULT_FROM_EMAIL=TALA-AI <noreply@tala.example.org>
FRONTEND_URL=https://tala.example.org
